# HTTPS for the platform domains and every vendor subdomain (<slug>.poslanka.lk).
# On-demand TLS only issues a certificate after the app confirms the host is ours
# (GET /api/tls-check?domain=... returns 200 for platform domains and existing vendor slugs),
# so nobody can make the server request certificates for arbitrary names.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:3000/api/tls-check
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy app:3000 {
		# WebSockets (realtime POS/kitchen updates) pass through automatically
		header_up X-Forwarded-Proto {scheme}
		transport http {
			read_timeout 0
		}
	}
}

# Fingerprint / attendance devices (ZKTeco ADMS "iclock" push, src/app/iclock): most terminals
# speak plain HTTP only and do not follow redirects, so /iclock/* is proxied on port 80 as well.
# The device is identified by its registered serial number; nothing else is served over HTTP.
(iclock_http) {
	handle /iclock/* {
		reverse_proxy app:3000 {
			header_up X-Forwarded-Proto http
		}
	}
}

http://168.144.216.104 {
	import iclock_http
	handle {
		redir https://168-144-216-104.sslip.io{uri} permanent
	}
}

http:// {
	import iclock_http
	handle {
		redir https://{host}{uri} permanent
	}
}
