{
  "build": {
    "builder": "nixpacks",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/api/health",
    "variables": {
      "SKIP_MIGRATIONS": "true",
      "REQUIRE_MIGRATIONS": "false",
      "NODE_ENV": "production",
      "NEXT_PUBLIC_APP_NAME": "POSLanka"
    },
    "preDeployCommand": "npm run db:migrate"
  }
}
