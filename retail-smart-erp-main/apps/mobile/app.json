{
  "expo": {
    "name": "skyERPOS",
    "slug": "poslanka",
    "version": "1.3.1",
    "orientation": "portrait",
    "scheme": "poslanka",
    "userInterfaceStyle": "light",
    "android": {
      "package": "lk.poslanka.app",
      "versionCode": 6,
      "permissions": [
        "CAMERA",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "BLUETOOTH_ADMIN",
        "ACCESS_FINE_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "lk.poslanka.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow skyERPOS to scan barcodes",
        "NSBluetoothAlwaysUsageDescription": "Allow skyERPOS to connect to Bluetooth receipt printers"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow skyERPOS to scan barcodes"
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#0050C0",
          "defaultChannel": "poslanka-default"
        }
      ],
      "expo-sqlite",
      "./plugins/withReleaseSigning",
      "./plugins/withCleartextTraffic"
    ],
    "extra": {
      "apiBaseUrl": "https://app.poslanka.lk"
    },
    "notification": {
      "color": "#0050C0",
      "androidMode": "default",
      "androidCollapsedTitle": "skyERPOS"
    },
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
