# ==================== POSLanka Environment ====================
# Copy to .env and fill in values before running npm run dev

# App branding
NEXT_PUBLIC_APP_NAME=POSLanka
NEXT_PUBLIC_BASE_DOMAIN=localhost
NEXT_PUBLIC_LANDING_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_DOMAIN=localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poslanka
# REQUIRED in production: non-superuser role the app switches to per request so
# row-level security isolates tenants. Created by migration 0026/0073 as app_user.
# GET /api/health reports tenantIsolation = app_role | owner_force_rls | UNSAFE_SUPERUSER_NO_ROLE
DATABASE_APP_ROLE=app_user
# Managed PostgreSQL (DigitalOcean etc.): SSL is enabled automatically for ondigitalocean.com
# hosts or ?sslmode=require. Paste the cluster's CA certificate to verify it (recommended):
DATABASE_CA_CERT=
# disable | no-verify | verify   (optional override)
DATABASE_SSL=
# Connections per app instance (default 15). Keep instances x this below the DB connection limit.
DATABASE_POOL_MAX=15

# Auth (NextAuth v5)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL_INTERNAL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# File storage: any S3-compatible service. STORAGE_* names win; legacy R2_* names still work.
#   DigitalOcean Spaces: STORAGE_ENDPOINT=https://sgp1.digitaloceanspaces.com  STORAGE_REGION=us-east-1
#                        STORAGE_PUBLIC_URL=https://<bucket>.sgp1.cdn.digitaloceanspaces.com  STORAGE_PUBLIC_ACL=public-read
#   Cloudflare R2:       STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com  STORAGE_REGION=auto  (no ACL)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=poslanka-uploads
STORAGE_PUBLIC_URL=
STORAGE_PUBLIC_ACL=

# Email (Resend)
RESEND_API_KEY=
SYSTEM_EMAIL_FROM=noreply@localhost

# PayHere (Sri Lanka billing)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox
PAYHERE_SANDBOX=true
# Refunds from the super-admin console (PayHere Merchant API). Create a "Business App" in the
# PayHere merchant portal (Integrations → API keys) with the Refund permission; these are NOT the
# merchant id / secret above. Sandbox vs live follows PAYHERE_MODE.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

# WebXPay (optional second gateway)
WEBXPAY_API_KEY=
WEBXPAY_API_SECRET=
WEBXPAY_MODE=sandbox

# WhatsApp (Cloud API optional; wa.me share works without these)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# AI (optional)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# PWA push notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# Super admin bootstrap (used once by: npm run db:seed-admin)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# Mobile push notifications (optional Expo access token for the push API)
EXPO_ACCESS_TOKEN=

# Scheduled jobs: shared secret for every /api/cron/* route (Authorization: Bearer <CRON_SECRET>).
# Routes return 401 while it is unset. Generate with: openssl rand -hex 32
# The GitHub Actions workflow .github/workflows/cron.yml needs repository secrets
# CRON_SECRET (same value) and APP_URL (e.g. https://app.poslanka.lk).
CRON_SECRET=
# /api/cron/einvoice-sync (every 10 min) transmitter: 'disabled' (default) only queues e-invoices
EINVOICE_TRANSMITTER=disabled

# Migrations
SKIP_MIGRATIONS=false
REQUIRE_MIGRATIONS=false

# ==================== Operations / non-functional (docs/PRODUCTION_DEPLOYMENT.md §7) ====================
# METRICS_TOKEN=                        # enables GET /api/metrics (Authorization: Bearer <token>)
# LOG_FORMAT=json                       # json (default in production) | pretty
# LOG_LEVEL=info
# DB_STATEMENT_TIMEOUT_MS=30000         # per pooled connection, 0 = off
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# SLOW_QUERY_MS=500
# SLOW_REQUEST_MS=2000
# SHUTDOWN_TIMEOUT_MS=25000
# OUTBOUND_TIMEOUT_MS=10000             # SMS / e-mail / push / WhatsApp calls (AI: 30 s)
# UPLOAD_MAX_MB=20
# SSE_TOKEN_MAX_AGE_SEC=300
# BROADCAST_FANOUT=on                   # off = no cross-instance realtime fan-out
# PG_LISTEN=on                          # off = no LISTEN connection at all (scripts)
# ALLOW_LOCAL_UPLOADS=false             # production: refuse local-disk uploads unless true
# AI_ERROR_ANALYSIS=on                  # off = never send error text to the AI provider
# RETENTION_ACTIVITY_LOGS_DAYS=400      # RETENTION_<TABLE>_DAYS overrides, 0 = keep forever
